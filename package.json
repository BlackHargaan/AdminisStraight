{
  "name": "adminisstraight-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Local-first school leadership planner",
  "author": "AdminisStraight",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.*",
    "build:mac": "electron-builder --mac zip dmg --arm64 --x64 --publish never",
    "build:windows": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.adminisstraight.desktop",
    "productName": "AdminisStraight",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "BlackHargaan",
      "repo": "AdminisStraight",
      "releaseType": "draft"
    },
    "generateUpdatesFilesForAllChannels": true
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
